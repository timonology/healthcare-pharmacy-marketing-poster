# Where each environment deploys to.
#
#   cp infra/azure/ship-targets.env.example infra/azure/ship-targets.env
#
# Only needed to override the built-in defaults, or to fill in the dev
# environment, which has none. Holds no secrets — resource names only —
# so committing it is fine if you'd rather everyone share one copy.

# ── production ──────────────────────────────────────────────────────────
# These are the built-in defaults and what `pnpm ship` has always targeted.
# Listed here so it is obvious what `pnpm ship:prod` will restart.
PROD_RG=rg-sonar-pharmacyposter
PROD_API_APP=sonarmarketingbackend
PROD_WEB_APP=sonar-marketing-auth
PROD_AI_APP=sonar-marketing-ai

# ── test / QA ───────────────────────────────────────────────────────────
# Normally left blank: ship.sh reads NAME_PREFIX and RESOURCE_GROUP out of
# infra/azure/test.env, so the QA environment is described in one place.
# Set these only if your test apps do not follow the <prefix>-api pattern.
# TEST_RG=rg-pharmacyposter-test
# TEST_API_APP=pharmtest-api
# TEST_WEB_APP=pharmtest-web
# TEST_AI_APP=pharmtest-ai

# ── shared dev ──────────────────────────────────────────────────────────
# No defaults, deliberately. `pnpm ship:dev` refuses to touch Azure until
# these are filled in, rather than guessing a name and restarting whatever
# happens to match. Until then, `pnpm ship:dev --no-restart` still builds
# and pushes the :dev images.
DEV_RG=
DEV_API_APP=
DEV_WEB_APP=
DEV_AI_APP=
