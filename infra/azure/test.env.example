# Configuration for the QA/test environment.
#
#   cp infra/azure/test.env.example infra/azure/test.env
#   # fill in the blanks, then:
#   ./scripts/deploy-test-env.sh            # dry run
#   ./scripts/deploy-test-env.sh --apply
#
# test.env is gitignored. Do not commit it — it holds live credentials.

# ── where ───────────────────────────────────────────────────────────────
RESOURCE_GROUP=rg-pharmacyposter-test
LOCATION=uksouth

# 11 characters max, lowercase letters and digits only. Every resource name
# is built from this, so it must differ from production's.
NAME_PREFIX=pharmtest

# Optional but recommended: the deploy script refuses to run if NAME_PREFIX
# matches this, which is the one mistake that would deploy over production.
PROD_NAME_PREFIX=pharmposter

# B1 is enough for QA. Production sizing does not need to be matched, and
# a smaller plan makes the environment cheap to leave running.
APP_SERVICE_SKU=B1

# ── secrets ─────────────────────────────────────────────────────────────
# Generate a fresh one — do NOT reuse production's. Sharing a JWT secret
# means a token minted by test is accepted by production.
#   openssl rand -base64 48
JWT_SECRET=
# Signs the browser's address from the web app to the API, so rate limits
# cannot be dodged by calling the API directly (security review R2-03).
# openssl rand -base64 48
CLIENT_IP_SIGNING_KEY=
# Master key for emailed poster-image and video links, so JWT_SECRET can be
# rotated without breaking them (security review R2-13). Set once, keep stable.
# openssl rand -base64 48
LINK_SIGNING_SECRET=

# Must be 16+ characters or the seeder refuses and you get no admin account.
#   openssl rand -base64 24
SUPERADMIN_EMAIL=superadmin@sonarinformatics.com
SUPERADMIN_PASSWORD=

# ── demo data ───────────────────────────────────────────────────────────
# Creates the 12 demo pharmacies — a deliberate spread across Free/Starter/Pro,
# with some deactivated and some mid-onboarding so filters and bulk actions
# have something real to act on.
SEED_DEMO=true

# Blank uses the password committed in this repo, which anyone with repo
# access knows. Set your own for an environment on a public URL, and share
# it with QA through your password manager rather than in a ticket.
DEMO_PASSWORD=

# ── email ───────────────────────────────────────────────────────────────
# true  = campaigns really send
# false = mock sender, nothing leaves the box
SEND_REAL_EMAIL=true

# Use a Mailjet subaccount or at minimum a DIFFERENT sending subdomain from
# production. Bounces and spam complaints attach to the sending domain, so
# QA traffic on production's domain degrades real pharmacies' deliverability.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_ADDRESS=no-reply@test.sonarinformatics.com
MAIL_FROM_NAME=Sonar Marketing (TEST)

# The deploy script warns if MAIL_FROM_ADDRESS matches this.
PROD_MAIL_FROM_ADDRESS=info@sonarinformatics.com
