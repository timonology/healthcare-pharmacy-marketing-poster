# Browser-facing URL of the .NET API (used by client code via redirects, etc.)
NEXT_PUBLIC_API_URL=https://api.your-domain.example

# Server-to-server URL the Next.js BFF uses to reach the API.
# In Azure App Service, point this at the API's https://*.azurewebsites.net hostname.
API_INTERNAL_URL=https://api.your-domain.example

# Set to "true" in production so the auth cookies get the Secure flag.
COOKIE_SECURE=true

# The port the Next.js server listens on. Azure App Service for Containers
# injects WEBSITES_PORT or PORT; the Dockerfile honors $PORT.
PORT=3000
