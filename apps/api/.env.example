# All of these map to ASP.NET Core configuration via the ":" double-underscore convention.
# In Azure App Service, set them as Application Settings.

ASPNETCORE_ENVIRONMENT=Production

# Mongo / Cosmos DB for MongoDB (vCore or RU)
Mongo__ConnectionString=mongodb+srv://USER:PASS@your-cluster.mongocluster.cosmos.azure.com/acme?tls=true&authSource=admin&replicaSet=globaldb&retrywrites=false
Mongo__Database=acme

# JWT signing
Jwt__Secret=GENERATE_A_64_CHAR_RANDOM_STRING
Jwt__Issuer=acme-api
Jwt__Audience=acme-clients
Jwt__ExpiryMinutes=60

# Refresh-token lifetime in days
Auth__RefreshTokenDays=30

# Azure Blob Storage (logos, exported poster thumbnails)
AzureBlob__ConnectionString=DefaultEndpointsProtocol=https;AccountName=acmeposterstore;AccountKey=...;EndpointSuffix=core.windows.net
AzureBlob__Container=canvas-assets

# CORS — JSON array (semicolon-separated values also accepted by .NET Configuration)
Cors__Origins__0=https://app.your-domain.example

# Sonar Informatics lookup (use UseMock=true until you have credentials)
Sonar__BaseUrl=https://sonar.example/api
Sonar__ApiKey=
Sonar__UseMock=true

# Email sending — pick a provider
Messaging__UseMock=false
Messaging__Provider=mailjet          # "mailjet" or "smtp"

# --- Mailjet Send API v3.1 (recommended) ---
# Values live in App Service / Railway secrets — never commit them.
Messaging__Mailjet__ApiKey=YOUR_MAILJET_API_KEY
Messaging__Mailjet__SecretKey=YOUR_MAILJET_SECRET_KEY
Messaging__Mailjet__FromAddress=no-reply@your-domain.example
Messaging__Mailjet__FromName=Pharmacy Poster
# Optional — Mailjet accepts messages but doesn't deliver. Great for CI.
Messaging__Mailjet__SandboxMode=false

# --- SMTP (alternative, e.g. SendGrid, MailPit for local) ---
Messaging__Smtp__Host=smtp.sendgrid.net
Messaging__Smtp__Port=587
Messaging__Smtp__EnableSsl=true
Messaging__Smtp__User=apikey
Messaging__Smtp__Password=YOUR_SENDGRID_API_KEY
Messaging__Smtp__FromAddress=no-reply@your-domain.example
Messaging__Smtp__FromName=Pharmacy Poster
