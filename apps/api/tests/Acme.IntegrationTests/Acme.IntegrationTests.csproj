<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Separate from Acme.Tests on purpose.

    Acme.Tests must stay runnable anywhere with nothing installed — it is the
    suite people run constantly, and the moment it needs a database it becomes
    the suite people skip. This project needs a real MongoDB and boots the whole
    web host, so it is slower and has a prerequisite. Keeping them apart means
    `pnpm test:api` never gets slower and never starts failing for reasons that
    have nothing to do with the code.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Acme.Application\Acme.Application.csproj" />
    <ProjectReference Include="..\..\src\Acme.Domain\Acme.Domain.csproj" />
    <ProjectReference Include="..\..\src\Acme.Infrastructure\Acme.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Acme.WebApi\Acme.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>
</Project>
