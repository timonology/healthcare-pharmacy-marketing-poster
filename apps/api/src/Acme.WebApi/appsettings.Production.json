{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "https://CHANGE_ME_WEB_HOSTNAME"
    ]
  },
  "Mongo": {
    "Database": "acme"
  },
  "Jwt": {
    "Issuer": "acme-api",
    "Audience": "acme-clients",
    "ExpiryMinutes": 20
  },
  "Auth": {
    "RefreshTokenDays": 30
  },
  "AzureBlob": {
    "Container": "canvas-assets"
  },

  "SuperAdmin": {
    "Enabled": false,
    "DisplayName": "Super Admin"
  },

  "SmokeAccount": {
    "Enabled": false
  },

  "Stripe": {
    "Enabled": true,
    "SuccessUrl": "https://marketing25.co.uk/billing/success",
    "CancelUrl": "https://marketing25.co.uk/pricing",
    "PortalReturnUrl": "https://marketing25.co.uk/profile"
  },
  "Sonar": {
    "TimeoutSeconds": 5,
    "UseMock": true
  },
  "Messaging": {
    "UseMock": false,
    "Provider": "mailjet",
    "Smtp": {
      "FromName": "Sonar Marketing25",
      "EnableSsl": true,
      "Port": 587
    },
    "Mailjet": {
      "FromName": "Sonar Marketing25",
      "SandboxMode": false
    },
    "Sms": {
      "Provider": "mock",
      "SenderId": "PHARMACY"
    }
  }
}
