<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Acme.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acme.Application\Acme.Application.csproj" />
    <ProjectReference Include="..\Acme.Domain\Acme.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      3.x: the 2.x line depends on SharpCompress 0.30.1 and Snappier 1.0.0, both
      with published advisories, and has no release that moves off them. The
      .NET 10 SDK audits transitive packages and fails the build on them.
    -->
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.21.0" />
    <PackageReference Include="Stripe.net" Version="45.14.0" />
    <!--
      Pinned above what Stripe.net 45 asks for (12.0.3, advisory
      GHSA-5crp-9r3c-p9vr). 13.x is a drop-in for Stripe's use of it.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="QuestPDF" Version="2024.7.3" />
    <!--
      QR encoding for the booking link on posters and shop-window screens.

      Pure managed — the PngByteQRCode renderer needs no System.Drawing and so
      no libgdiplus, which is what makes it survive the Linux container. MIT
      licensed. Hand-rolling the encoder was the alternative and is not one: a
      wrong implementation still looks like a QR code and is found out on a wall.
    -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Shared by QuestPdfExporter for SVG/poster rasterization on the PDF path.
         Video pipeline now lives in the Python ai-service and does its own rasterization. -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    <PackageReference Include="Svg.Skia" Version="1.0.0.18" />
  </ItemGroup>

  <!--
    The house-style templates and their photographs, embedded so a fresh
    environment seeds them with no network access. Generated by
    apps/ai-service/app/tools/house_templates.py and house_template_assets.py.
    The photographs are absent until that script has been run once; the seeder
    then holds those templates back and says why, rather than failing the build.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence\HouseTemplates\templates.json"
                      LogicalName="HouseTemplates.templates.json" />
    <EmbeddedResource Include="Persistence\HouseTemplates\assets\*.jpg;Persistence\HouseTemplates\assets\*.png"
                      LogicalName="HouseTemplates.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
