# Keep the build context small. Anything filtered here is invisible to
# every Dockerfile that uses `context: .`.
**/node_modules
**/.next
**/dist
**/.pnpm-store
**/.turbo

# .NET build output
**/bin
**/obj
**/.vs

# Python
**/__pycache__
**/.venv
**/.pytest_cache
**/.ruff_cache

# Editor / OS
.git
.idea
.vscode
.DS_Store
*.user
*.suo

# Env files — secrets stay out of images.
.env
.env.local
.env.*.local
