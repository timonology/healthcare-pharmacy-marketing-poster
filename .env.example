# =====================================================================
# Local development env vars. Copy to .env and fill in real values.
# Production values should come from Azure Key Vault, not this file.
# =====================================================================

# ----- Shared -----
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# ----- JWT (issued by .NET API, validated everywhere) -----
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
# Optional locally. Signs the browser's address from the web app to the API
# (security review R2-03). Set it in production: openssl rand -base64 48
CLIENT_IP_SIGNING_KEY=
# Readiness checks from inside each service (GET /api/health/ready, /health/ready).
# One long random value (openssl rand -hex 24) on the API (Readiness__Token) and
# ai-service (READINESS_TOKEN); pnpm smoke sends SMOKE_READINESS_TOKEN.
READINESS_TOKEN=
SMOKE_READINESS_TOKEN=
# Optional. Master key for emailed poster-image and video links, separate from
# JWT_SECRET so that can be rotated without breaking links (R2-13).
LINK_SIGNING_SECRET=
JWT_ISSUER=acme-api
JWT_AUDIENCE=acme-clients
JWT_EXPIRY_MINUTES=60

# ----- Database (Cosmos DB MongoDB API in prod, Mongo container in dev) -----
# Local docker-compose:
MONGO_CONNECTION_STRING=mongodb://root:example@127.0.0.1:27017/acme?authSource=admin
MONGO_DATABASE=acme
# Azure Cosmos DB (production) — from `az cosmosdb keys list --type connection-strings`
# AZURE_COSMOS_CONNECTION_STRING=mongodb+srv://<user>:<key>@<account>.mongo.cosmos.azure.com:10255/?ssl=true&retrywrites=false&...

# ----- Azure Blob Storage -----
AZURE_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_BLOB_CONTAINER=canvas-assets
AZURE_BLOB_ACCOUNT_NAME=
AZURE_BLOB_ACCOUNT_KEY=

# ----- Azure OpenAI (used by ai-service for canvas AI) -----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ----- Video agent (used by ai-service video pipeline) -----
# Required: Anthropic (script), Tavily (research), Pexels (visuals).
# See apps/ai-service/README.md for signup links + cost per video.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
TAVILY_API_KEY=
PEXELS_API_KEY=

# Blank disables AI imagery. (Narration is not optional when hosted — see below.)
# Narration. Setting this makes ElevenLabs THE narrator: no fallback to
# Edge-TTS, because Edge-TTS is an unofficial route into Microsoft's consumer
# speech service and is refused from datacentre networks — which is why every
# production render failed at the voice stage while local ones worked.
# Leave empty for local development; Edge-TTS is then used and is free.
ELEVENLABS_API_KEY=
# Optional. Unset, the first voice on the account is used and logged at render.
ELEVENLABS_DEFAULT_VOICE_ID=
REPLICATE_API_TOKEN=
REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell

# Cost caps for the AI-imagery visual style. Only consulted when
# a user picks visualStyle=AiImagery (Pro tier).
AI_IMAGERY_MAX_IMAGES_PER_JOB=8
AI_IMAGERY_BUDGET_PER_JOB_USD=0.05
AI_IMAGERY_COST_PER_IMAGE_USD=0.003

# Worker toggles. Set VIDEO_WORKER_ENABLED=false to run canvas-only.
VIDEO_WORKER_ENABLED=true
VIDEO_WORKER_POLL_SECONDS=4

# ----- Bootstrap SuperAdmin -----
# Seeds the first admin account on an empty database so there's a way into
# /admin. Skipped automatically once any SuperAdmin exists.
#
# In production the seeder REFUSES passwords under 16 chars or containing
# common words — a known-address account with a guessable password and total
# access is worse than no seeded account at all. Set Enabled=false once you've
# signed in and changed the password.
SUPERADMIN_ENABLED=true
SUPERADMIN_EMAIL=superadmin@sonar.local
SUPERADMIN_PASSWORD=ChangeMe-Dev-Only-123
SUPERADMIN_NAME=Super Admin

# ----- Stripe (billing) -----
# Leave STRIPE_ENABLED=false to develop without billing. When false the
# checkout endpoints return a clear error and /api/subscription/upgrade
# still works as a local tier switch.
#
# Generate the price ids with: cd scripts/stripe && ./create_stripe_prices.sh
# Get the webhook secret from: stripe listen --forward-to http://localhost:5050/api/billing/webhook
# Full walkthrough: docs/STRIPE_SETUP.md
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_50=

# ----- Service URLs -----
# Host-side ports for docker-compose. Override if any are taken.
# (Port 5000 on macOS is grabbed by AirPlay Receiver, hence the 5050 default.)
API_HOST_PORT=5050
WEB_HOST_PORT=9090
AI_HOST_PORT=8000

NEXT_PUBLIC_API_URL=http://localhost:5050
NEXT_PUBLIC_AI_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8080
AI_INTERNAL_URL=http://ai-service:8000
# Public web address: canonical links, sitemap.xml, robots.txt, link previews.
SITE_URL=http://localhost:9090
# Content-Security-Policy for pages: report-only (default) | enforce | off.
CSP_MODE=report-only

# Set to "true" only when serving the web app over HTTPS (production).
# When true, auth cookies are flagged Secure and browsers refuse them on http://.
COOKIE_SECURE=false

# ----- Social publishing & Google Ads -----
# Encrypts stored Facebook/Instagram/Google tokens at rest. Required before any
# account can be connected. Generate with: openssl rand -base64 32
# Losing this means every pharmacy must reconnect their accounts.
SOCIAL_ENCRYPTION_KEY=

# Meta app (developers.facebook.com → your app → Settings → Basic)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy: Google sunset developer tokens on 10 Sep 2026 — Ads access now comes
# from the OAuth client's Cloud project (Google Ads API page in Cloud Console).
# Leave blank.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Ads API version (supported until about a year after release).
GOOGLE_ADS_API_VERSION=v25
# true = Google validates each campaign creation and creates nothing. Use
# this for the first runs against your test account.
GOOGLE_ADS_VALIDATE_ONLY=false

# LinkedIn (developer.linkedin.com → your app → Auth). Profile posting needs
# the "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# products. Set LINKEDIN_PAGES_ENABLED=true only after LinkedIn approves the
# app for the Community Management API.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_PAGES_ENABLED=false

# TikTok (developers.tiktok.com → your app). Needs Login Kit and the Content
# Posting API (Direct Post), scopes user.info.basic and video.publish.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X (console.x.com → your app). OAuth 2.0 Client ID and Secret (not the
# API key), app type "Web App", callback <web>/social/callback/x. Posting is
# pay-per-use: the developer account needs credits.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Set false to stop this instance publishing scheduled posts.
SOCIAL_WORKER_ENABLED=true

# ----- Azure resource identifiers (for deployment scripts only) -----
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus
AZURE_TENANT_ID=
AZURE_KEYVAULT_NAME=
AZURE_CONTAINER_REGISTRY=

# ----- Smoke test (pnpm smoke) -----
# One cheap call through every paid door, against a deployment that is actually
# running. Read by scripts/smoke/run.mjs; see docs/SMOKE.md.
#
# Anything set in the real environment beats this file, so pointing one run
# somewhere else still works:
#   API_URL=https://...  WEB_URL=https://...  pnpm smoke
#
# Which stack to hit. Compose publishes web on WEB_HOST_PORT (9090); `pnpm
# dev:web` serves 3000. Left unset, the smoke follows the *_HOST_PORT values
# above so it agrees with docker-compose rather than guessing.
API_URL=http://localhost:5050
AI_URL=http://localhost:8000
WEB_URL=http://localhost:9090

# The account it signs in as — its own, not the SuperAdmin.
#
# The API seeds this account on startup (SmokeAccountSeeder) from these exact
# two variables, so there is one credential rather than two that drift. It is an
# ordinary pharmacy user on the Pro plan: least privilege if it ever leaks, and
# a paid plan so the video and AI-design doors are actually open. Staff sit on
# Free, which is why running as the SuperAdmin skipped both.
#
# Change these and the seeder creates the new account on the next API start. It
# never touches an account that already exists, so changing the password here
# does NOT change it on the server — delete the account first, or change it in
# the app.
SMOKE_EMAIL=smoke@sonar.local
SMOKE_PASSWORD=Smoke-Dev-Only-123!

# Seeding controls, read by the API (not the runner). Set ENABLED=false once the
# account exists if you would rather it never be recreated. Outside Development
# the seeder refuses this published password outright.
SMOKE_ACCOUNT_ENABLED=true
SMOKE_ACCOUNT_TIER=Pro
SMOKE_PHARMACY_NAME=Smoke Test Pharmacy

# Where the one campaign email goes. A real inbox — the point of the step is
# that a person can confirm it arrived and looked right.
SMOKE_EMAIL_TO=timothy.babalola009@gmail.com

# How long to wait for a render before calling it stuck. A measured end-to-end
# render took 3m28s locally (91s of it ffmpeg), so three minutes reported a
# working pipeline as broken. Five, with headroom over the realistic case.
#
# Running past this is not automatically a failure: a render still reporting new
# stages is a WARN, and only one that has stopped moving is a FAIL.
SMOKE_VIDEO_TIMEOUT_MS=300000
SMOKE_CAMPAIGN_TIMEOUT_MS=90000

# Set to 1 to keep the poster, video and screen it creates (or use pnpm smoke:keep).
# Anything that FAILS is kept regardless — evidence outlives tidiness.
SMOKE_KEEP=0
