# =====================================================================
# Local development env vars. Copy to .env and fill in real values.
# Production values should come from Azure Key Vault, not this file.
# =====================================================================

# ----- Shared -----
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# ----- JWT (issued by .NET API, validated everywhere) -----
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_ISSUER=acme-api
JWT_AUDIENCE=acme-clients
JWT_EXPIRY_MINUTES=60

# ----- Database (Cosmos DB MongoDB API in prod, Mongo container in dev) -----
# Local docker-compose:
MONGO_CONNECTION_STRING=mongodb://root:example@localhost:27017/acme?authSource=admin
MONGO_DATABASE=acme
# Azure Cosmos DB (production) — from `az cosmosdb keys list --type connection-strings`
# AZURE_COSMOS_CONNECTION_STRING=mongodb+srv://<user>:<key>@<account>.mongo.cosmos.azure.com:10255/?ssl=true&retrywrites=false&...

# ----- Azure Blob Storage -----
AZURE_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_BLOB_CONTAINER=canvas-assets
AZURE_BLOB_ACCOUNT_NAME=
AZURE_BLOB_ACCOUNT_KEY=

# ----- Azure OpenAI (used by ai-service) -----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ----- Service URLs -----
# Host-side ports for docker-compose. Override if any are taken.
# (Port 5000 on macOS is grabbed by AirPlay Receiver, hence the 5050 default.)
API_HOST_PORT=5050
WEB_HOST_PORT=9090
AI_HOST_PORT=8000

NEXT_PUBLIC_API_URL=http://localhost:5050
NEXT_PUBLIC_AI_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8080
AI_INTERNAL_URL=http://ai-service:8000

# Set to "true" only when serving the web app over HTTPS (production).
# When true, auth cookies are flagged Secure and browsers refuse them on http://.
COOKIE_SECURE=false

# ----- Azure resource identifiers (for deployment scripts only) -----
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus
AZURE_TENANT_ID=
AZURE_KEYVAULT_NAME=
AZURE_CONTAINER_REGISTRY=
